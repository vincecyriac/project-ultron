# Google Gemini API Credentials
GEMINI_API_KEY=your_gemini_api_key_here
TESTING_MODE=true

# Gemini Live model (voice + realtime)
GEMINI_MODEL=gemini-3.1-flash-live-preview

# FRIDAY's voice for the Live session.
# Aoede (natural, articulate feminine tone — default) or Kore, also feminine.
# Charon and Puck are masculine and will not match her persona.
FRIDAY_VOICE=Aoede

# Tripo3D text-to-3D (generate_spatial_3d_asset). Without it FRIDAY still builds
# SVE diagrams; only photoreal .glb generation is unavailable.
# Key: https://platform.tripo3d.ai
TRIPO_API_KEY=your_tripo_api_key_here
