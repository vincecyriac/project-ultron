# Google Gemini API Credentials
GEMINI_API_KEY=your_gemini_api_key_here
TESTING_MODE=true

# Gemini Live model (voice + realtime)
GEMINI_MODEL=gemini-3.1-flash-live-preview

# Assistant voice for the Live session.
# Charon (deep, grounded — default), Kore, or Puck (lighter).
ULTRON_VOICE=Charon

# Optional. Your city, used only for the return-to-desk briefing card's weather.
# Leave unset and the weather section is omitted rather than guessed.
ULTRON_LOCATION=
