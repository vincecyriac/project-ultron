# Google Gemini API Credentials
GEMINI_API_KEY=your_gemini_api_key_here
TESTING_MODE=true

# Gemini Live model (voice + realtime)
GEMINI_MODEL=gemini-3.1-flash-live-preview

# LM Studio local models (OpenAI-compatible server)
# Start the server in LM Studio: Developer tab -> Start Server (default port 1234)
LMSTUDIO_BASE_URL=http://127.0.0.1:1234/v1
# Comma-separated model ids exactly as LM Studio shows them, e.g.:
# LOCAL_MODELS=qwen/qwen3-8b,google/gemma-3-4b
LOCAL_MODELS=
